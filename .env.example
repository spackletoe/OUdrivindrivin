# Required — Discord application bot token
# Create at https://discord.com/developers/applications → Bot → Reset Token
DISCORD_BOT_TOKEN=your_discord_bot_token

# Optional — overrides discord.channel_id in config/settings.yaml
# Right-click the report channel in Discord (Developer Mode on) → Copy Channel ID
# DISCORD_CHANNEL_ID=123456789012345678

# Optional — iRacing Data API credentials for official post-race results
# IRACING_EMAIL=you@example.com
# IRACING_PASSWORD=your_iracing_password
